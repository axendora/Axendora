# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here  # SOLO server, nunca exponer al cliente

# Email transaccional
RESEND_API_KEY=re_your-resend-api-key-here
# Remitente verificado en Resend (ej: "Axendora <hola@axendora.com>")
# En desarrollo puedes dejar en blanco para usar onboarding@resend.dev
RESEND_FROM=

# URL del sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000
